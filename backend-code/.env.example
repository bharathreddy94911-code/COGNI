# =============================================================================
# Backend Environment Configuration Template
# =============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
APP_ENV=production

# Security & Authentication (JWT HS256)
JWT_SECRET_KEY=your-production-jwt-secret-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite or Amazon RDS PostgreSQL)
# SQLite: sqlite:///data/loan_agent.db
# PostgreSQL: postgresql://postgres:password@rds-instance.region.rds.amazonaws.com:5432/loan_db
DATABASE_URL=sqlite:///data/loan_agent.db

# CORS Allowed Origins (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-app.com

# Amazon Web Services (AWS) Storage Settings
# When AWS_S3_BUCKET is set, documents are persisted directly in S3.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-loan-documents-bucket

# Local AWS Credentials (Only required for local testing; in AWS, use IAM Task/Instance Roles)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AI / Ollama Model Server Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
