# =============================================================================
# Root Environment Variables Template — Loan Document Processing Agent
# =============================================================================

# Application Environment (development, staging, production)
APP_ENV=production
DEBUG=false

# -----------------------------------------------------------------------------
# Backend Service Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# Security & Authentication (Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-production-jwt-secret-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; use Amazon RDS PostgreSQL in production)
# SQLite example: sqlite:///data/loan_agent.db
# PostgreSQL example: postgresql://dbuser:dbpassword@rds-instance.region.rds.amazonaws.com:5432/loan_db
DATABASE_URL=sqlite:///data/loan_agent.db

# Allowed CORS Origins (comma-separated list of approved frontend domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# -----------------------------------------------------------------------------
# Amazon Web Services (AWS) Storage Configuration
# -----------------------------------------------------------------------------
# When AWS_S3_BUCKET is set, the application persists documents in Amazon S3.
# When omitted, the application uses local directory storage (development mode).
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-loan-documents-s3-bucket-name
# In production on AWS (ECS, App Runner, EC2), credentials are provided automatically via IAM Task/Instance Roles.
# For local development with AWS, configure AWS CLI (`aws configure`) or provide keys:
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# -----------------------------------------------------------------------------
# AI / LLM Configuration
# -----------------------------------------------------------------------------
# Ollama endpoint (falls back automatically to deterministic rule engines if unreachable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# -----------------------------------------------------------------------------
# Frontend Service Configuration
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
